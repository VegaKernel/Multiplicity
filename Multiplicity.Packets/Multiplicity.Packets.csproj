<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <PackageId>Multiplicity</PackageId>
    <Version>2.6.0</Version>
    <AssemblyName>Multiplicity.Packets</AssemblyName>
    <RootNamespace>Multiplicity.Packets</RootNamespace>
    <Authors>VegaKernel</Authors>
    <Description>Low-level Terraria packet serialization/deserialization library with typed packet models and zero-copy packet views for protocol 325 (Terraria 1.4.5.7).</Description>
    <PackageTags>Terraria;Packets;Networking;TShock</PackageTags>
    <PackageProjectUrl>https://github.com/VegaKernel/Multiplicity</PackageProjectUrl>
    <RepositoryUrl>https://github.com/VegaKernel/Multiplicity</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Deterministic>false</Deterministic>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <Target Name="CopyBuildResult" AfterTargets="Build">
    <MakeDir Directories="$(MSBuildProjectDirectory)\_BuildResult" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)\_BuildResult" SkipUnchangedFiles="true" />
  </Target>
</Project>
