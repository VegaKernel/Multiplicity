<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <PackageId>Multiplicity</PackageId>
    <Version>3.0.0</Version>
    <AssemblyName>Multiplicity.Packets</AssemblyName>
    <RootNamespace>Multiplicity.Packets</RootNamespace>
    <Authors>VegaKernel</Authors>
    <Description>Low-level Terraria packet serialization/deserialization library with typed packet models and zero-copy packet views for protocol 329 (Terraria 1.4.6.1).</Description>
    <PackageTags>Terraria;Packets;Networking;TShock</PackageTags>
    <PackageProjectUrl>https://github.com/VegaKernel/Multiplicity</PackageProjectUrl>
    <RepositoryUrl>https://github.com/VegaKernel/Multiplicity</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
  </PropertyGroup>

  <!-- Runtime/package dependency policy: keep this project BCL-only; do not add runtime PackageReference items. -->
  <ItemGroup>
    <ProjectReference Include="..\Multiplicity.Packets.Generators\Multiplicity.Packets.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
